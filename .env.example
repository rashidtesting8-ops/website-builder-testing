# EditVista Environment Configuration
# Add your Groq API key below (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Alternative Providers (Optional)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Service Ports & Settings
PROJECTS_DIR=./projects
COCKPIT_BASE_URL=http://127.0.0.1:8888

# Optional API authentication (recommended for any non-local deployment)
# EDITVISTA_API_TOKEN=
# EDITVISTA_AUTH_MODE=required
# EDITVISTA_COOKIE_SECURE=1

# Optional GHL Public Asset Hosting (GitHub Pages)
# GHL_ASSET_HOST=github_pages
# GITHUB_PAGES_REPO=owner/repo
# GITHUB_TOKEN=
# GITHUB_PAGES_BRANCH=gh-pages
# GITHUB_PAGES_BASE_URL=
