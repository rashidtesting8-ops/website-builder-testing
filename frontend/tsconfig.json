{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "noEmitOnError": true,
    "outDir": "public",
    "rootDir": "src",
    "sourceMap": false,
    "declaration": false,
    "removeComments": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
